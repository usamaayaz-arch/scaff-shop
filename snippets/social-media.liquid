<div class="social-media d-flex align-center justify-center row">
  {%- if settings.facebook_icons_flag and settings.facebook -%}
    <a class="social-media-link rounded-sm d-flex align-center justify-center" href="{{settings.facebook}}">
      {{ 'facebook-icon.svg' | inline_asset_content }}
    </a>
  {%- endif -%}

  {%- if settings.instagram_icons_flag and settings.instagram -%}
    <a class="social-media-link rounded-sm d-flex align-center justify-center" href="{{settings.instagram}}">
      {{ 'instagram-icon.svg' | inline_asset_content }}
    </a>
  {%- endif -%}

  {%- unless footer_only -%}
    {%- if settings.yahoo_icons_flag and settings.yahoo -%}
      <a class="social-media-link rounded-sm d-flex align-center justify-center" href="{{settings.yahoo}}">
        {{ 'yahoo-icon.svg' | inline_asset_content }}
      </a>
    {%- endif -%}

    {%- if settings.pinterest_icons_flag and settings.pinterest -%}
      <a class="social-media-link rounded-sm d-flex align-center justify-center" href="{{settings.pinterest}}">
        {{ 'pinterest-icon.svg' | inline_asset_content }}
      </a>
    {%- endif -%}
  {%- endunless -%}
</div>

<style>
  .social-media {
    gap: 12px;
  }
  .social-media-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .social-media-link {
    width: 2rem;
    height: 2rem;
    background: #ffffff;
    text-align: center;
  }
</style>
