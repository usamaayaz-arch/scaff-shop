<form
  id="searchProductForm"
  class="search-form-{{ section.id }} d-flex justify-center align-center"
  action="{{ routes.search_url }}"
  method="get"
  role="search"
>
  <div class="search-input-wrapper-{{ section.id }}">
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder="Search products..."
      autocomplete="off"
      class="search-field-{{ section.id }} p-1"
    >
    <span class="close-icon-wrapper">
      {{ 'close-icon.svg' | inline_asset_content }}
    </span>
  </div>

  <div id="search-results-dropdown"></div>
</form>
<div class="search-overlay search-overlay-{{ section.id }}"></div>
<script>
  const closeIcon = document.querySelector('.close-icon-wrapper');
  const input = document.getElementById('search-input');
  const suggestions = document.getElementById('search-results-dropdown');

  input.addEventListener('input', function () {
    const query = input.value;

    if (query.length < 2) {
      suggestions.innerHTML = '';
      return;
    }

    fetch(`/search/suggest.json?q=${query}&resources[type]=product`)
      .then((response) => response.json())
      .then((data) => {
        let results = data.resources.results.products;

        if (!results || results.length === 0) {
          suggestions.innerHTML = '<p>No results found</p>';
          return;
        }

        let html = '<ul>';
        results.forEach((product) => {
          html += `
          <li>
            <a href="${product.url}">
              <img src="${product.image}" width="40">
              ${product.title}
            </a>
          </li>
        `;
        });
        html += '</ul>';
        suggestions.innerHTML = html;
      });
  });

  closeIcon.addEventListener('click', function () {
    const t = document.getElementsByClassName(`search-overlay-{{ section.id }}`)[0];
    const searchProductForm = document.getElementById('searchProductForm');

    if (searchProductForm) {
      searchProductForm.classList.remove('search-form-header-active');
      searchProductForm.style.display = 'none';
    }

    if (t) t.style.display = 'none';
  });
</script>

<style>
    .search-overlay-{{ section.id }}{
      display:none;
          position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    opacity: .75;
    background: #000000;
    box-shadow: 0px 0px 20px 0px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(75px);
    -webkit-backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .search-form-{{ section.id }} svg{cursor:pointer}
    .search-form-{{ section.id }} {
      position: fixed;
      width: 100%;
      top: 90px;
      left: 0;
      right: 0;
      z-index: 2;
      margin: auto 1rem !important;
      display:none;
    }

    #search-results-dropdown:empty {
      display: none;
    }

    .search-input-wrapper-{{ section.id }} {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      transform: translateX(16px);
    }

    .search-field-{{ section.id }} {
      max-width: 35rem;
      width: calc(100% - 6rem);
    }
    @media (max-width:426px){
    #search-results-dropdown ,
    .search-field-{{ section.id }} {
       width: calc(100% - 4rem) !important;
     }
    .search-input-wrapper-{{ section.id }} {
          justify-content: flex-start;
          transform: translateX(0px);
        }
    .search-form-{{ section.id }} {
            justify-content: flex-start;}
  }

    .search-field-{{ section.id }}:focus-visible {
      outline: none;
    }

    #search-results-dropdown {
      position: absolute;
      background: white;
      max-width: 35rem;
      width: calc(100% - 6rem);
      border: 1px solid #ddd;
      z-index: 1000;
      top: 50px;
    }

    #search-results-dropdown ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    #search-results-dropdown li {
      padding: 8px;
      border-bottom: 1px solid #eee;
    }

    #search-results-dropdown li a {
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }
</style>
