<div class="ticker ticker--{{ section.id }} p-relative overflow-hidden">
  <div class="ticker__track" style="{%if section.settings.border%}border-bottom: 1.5px solid lightgrey;{%endif%}">
    {%- if section.settings.loopthrough_flag == false -%}
      <div class="ticker__container d-flex align-center gap-2 px-1">
        {% for block in section.blocks %}
          <div class="ticker__item d-flex align-center gap-1h2" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img
                width="auto"
                height="auto"
                class="ticker__image"
                src="{{ block.settings.image | image_url }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.text != blank %}
              <div>{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {%- else -%}
      {% for i in (1..20) %}
        <div class="ticker__container d-flex align-center gap-2">
          {% for block in section.blocks %}
            <div class="ticker__item d-flex align-center gap-1h2" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <img
                  width="auto"
                  height="auto"
                  class="ticker__image"
                  src="{{ block.settings.image | image_url }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}

              {% if block.settings.text != blank %}
                <div>{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {%- endif -%}
  </div>
</div>
<style>
  .ticker--{{ section.id }} .ticker__track {
    display: flex;
    width: 100%;
    {% if section.settings.loopthrough_flag %}
      width: max-content;
      animation: ticker-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    {% endif %}
  }

  .ticker--{{ section.id }} .ticker__container {
    padding-top: {{ section.settings.padding_y }}rem;
    padding-bottom: {{ section.settings.padding_y }}rem;

    {% unless section.settings.loopthrough_flag %}
      justify-content: space-between;
      width: 100%;
    {% endunless %}
  }

  .ticker--{{ section.id }} .ticker__item {
    font-size: {{ section.settings.font_size }}rem;
    white-space: nowrap;
  }
    {% if section.settings.loopthrough_flag %}
  .ticker--{{ section.id }} .ticker__item:nth-child(1) {
    padding-left: 2rem;
  }
  {% endif %}

  .ticker--{{ section.id }} .ticker__image {
    width: {{ section.settings.image_size }}rem;
    height: auto;
  }

  {% if section.settings.loopthrough_flag %}
  @keyframes ticker-scroll-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-45%); }
  }

  .ticker--{{ section.id }}:hover .ticker__track {
    animation-play-state: paused;
  }
  {% endif %}
</style>
{% schema %}
{
  "name": "Ticker",
  "settings": [
    { "type": "checkbox", "id": "loopthrough_flag", "label": "loop through", "default": false },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image Size",
      "min": 1,
      "max": 20,
      "step": 0.2,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 1,
      "max": 20,
      "step": 0.2,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Space Top/Bottom",
      "min": 1,
      "max": 10,
      "step": 0.2,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "min": 5,
      "max": 100,
      "step": 1,
      "default": 20
    },
    { "type": "checkbox", "label": "border", "id": "border", "info": "border in the bottom will be added","default":false }
  ],
  "blocks": [
    {
      "name": "Ticker Item",
      "type": "ticker",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [{ "name": "Ticker" }]
}
{% endschema %}
