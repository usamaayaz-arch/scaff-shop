<div class="main-{{ section.id }}">
  <div class="container d-grid grid-template-col-2 gap-1 page-pa">
    <div class="left">
      {%- if product.featured_image -%}
        <div class="featured-image mb-1">
          <img
            height="auto"
            width="auto"
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt }}"
          >
        </div>
      {%- endif -%}
      {%- if product.images -%}
        <div class="product-media d-grid grid-template-col-2 gap-1">
          {% comment %} featured Image {% endcomment %}
          <img
            height="auto"
            width="auto"
            src="{{ product.featured_image | image_url}}"
            alt="{{ product.featured_image.alt }}"
          >
          {%- for image in product.images offset: 1 -%}
            <img width="auto" height="auto" src="{{ image | image_url }}" alt="{{ image.alt }}">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="right">
      {%- if section.settings.vendor -%}
        <div class="product-vendor"><strong>Brand:</strong> {{ product.vendor }}</div>
      {%- endif -%}

      <h1 style="letter-spacing: -2px;" class="product-title mb-1">{{ product.title | upcase }}</h1>

      {% if product.options_with_values.size > 0 %}
        <variant-selector data-product="{{ product | json | escape }}">
          <div class="product-options">
            <ul class="options-list">
              {% for option in product.options_with_values %}
                {%- if option.name != 'Title' -%}
                  {%- if option.name == 'color' or option.name == 'Color' -%}
                    <li data-parent="{{ option.name }}" class="option-label d-flex column gap-1  mb-2">
                      {%- for value in option.values -%}
                        {%- if value.selected -%}
                          {%- assign color_selected = value.name -%}
                        {%- endif -%}
                      {% endfor %}
                      <span class="variant-color d-flex gap-1 justify-left align-center wrap row capitalize">
                        <strong>{{ option.name }} : </strong>
                        <span class="selected-variant-color"> {{ color_selected -}}</span>
                      </span>
                      <ol class="d-flex row align-center gap-1h2">
                        {%- for value in option.values -%}
                          <li
                            data-value="{{ value }}"
                            data-parent="{{ option.name }}"
                            class="option-value d-flex wrap justify-center align-center p-relative circle {% if value.selected %}active{% endif %} "
                            style="border-radius:32px;width:2.2rem;height:2.2rem;cursor:pointer;"
                          >
                            <span
                              style="
                                display:block;width:1.7rem;height:1.7rem;border-radius:32px;position:absolute;
                                {% if value.swatch.image %}background-image:url({{ value.swatch.image | image_url: width: 50 }});
                                 background-size:cover;background-position:center;
                                 {% elsif value.swatch.color %}background:{{ value.swatch.color }};{% else %}background:{{ value.name }};{% endif %}
                              "
                            ></span>
                            {% comment %} <span style="display:block;width:1.7rem;height:1.7rem;background:{%if value.swatch.image%}{{value.swatch.image}}{% elsif value.swatch.color %} {{value.swatch.color}} {%else%}{{value.name}}{%endif%};border-radius: 32px;position: absolute;" ></span> {% endcomment %}
                          </li>
                        {%- endfor -%}
                      </ol>
                    </li>
                  {%- else -%}
                    <li data-parent="{{ option.name }}" class="option-label d-flex column gap-1 mb-2">
                      <strong>{{ option.name }} </strong>
                      <ol class="d-flex row wrap align-center gap-1h2">
                        {%- for value in option.values -%}
                          <li
                            data-value="{{ value }}"
                            data-parent="{{ option.name }}"
                            style="border: 1px solid #9F9F9F;width: 100%;max-width: 198px;text-align: center;padding: 1.063rem 0rem;cursor:pointer;"
                            class="option-value {% if value.selected %}active{% endif %} "
                          >
                            {{ value }}
                          </li>
                        {%- endfor -%}
                      </ol>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {% endfor %}
            </ul>
          </div>
        </variant-selector>
      {% endif %}
      <cart-handler>
        <div class="qunatity-price-container d-flex justify-space-between align-center">
          <div class="quantity-selector">
            <quantity-selector>
              {%- render 'quantity-selector', product: product.selected_or_first_available_variant, section: section -%}
            </quantity-selector>
          </div>
          {% assign variant = product.selected_or_first_available_variant %}
          <div class="d-flex align-center gap-1">
            {% if variant.compare_at_price > variant.price %}
              <span class="compare-price">
                {{ variant.compare_at_price | money }}
              </span>
            {% endif %}
            <span class="product-price">
              {{ variant.price | money }}
            </span>
          </div>
        </div>
        <div class="add-to-cart-{{ section.id }}">
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <!-- This hidden input is updated dynamically -->
            <input type="hidden" name="quantity" value="1" class="product_quantity">
            <button
              {% if product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
              id="add_to_cart_button"
              class="cart-button {% if product.selected_or_first_available_variant.available == false %}cart-button-disable{% endif %}"
              type="submit"
            >
              {{ 'general.cart_button_label' | t }}
            </button>
          </form>
        </div>
      </cart-handler>

      {%- if product.description != blank -%}
        <div class="product-description">
          <div class="accordion-header d-flex row justify-space-between">
            <strong>{{ 'general.description_label' | t }}</strong>
            {{ 'arrow-up.svg' | inline_asset_content }}
          </div>

          <div class="accordion-content">
            <ol>
              <li>{{ product.description }}</li>
            </ol>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  document.querySelector('.accordion-header').addEventListener('click', function () {
    this.parentElement.classList.toggle('toggle');
  });
</script>
<script src="{{ 'main-product.js' | asset_url }}" defer="defer"></script>
<style>
  .add-to-cart-{{ section.id }} { margin:2rem auto; }
  .add-to-cart-{{ section.id }} .cart-button{padding: 0.85rem; width: 100%; background: black; color: white; border: unset; cursor: pointer; }
  .add-to-cart-{{ section.id }} .cart-button-disable{background: #6a6868;    cursor: no-drop;}
  .main-{{section.id}} .right .product-description .accordion-header svg { width:1rem;height:1rem }
  .main-{{section.id}} .right .product-description .accordion-content ol li {text-transform: capitalize;}
  @media (max-width:768px){
  .main-{{ section.id }} .container { grid-template-columns: repeat(1, 2fr) !important; }
  .main-{{ section.id }} .container .left .product-media { grid-template-columns: repeat({{product.images.size}}, 2fr) !important; }
  }
</style>
{{ 'main-product.css' | asset_url | stylesheet_tag }}
{% schema %}
{
  "name": "main-product",
  "settings": [{ "type": "checkbox", "label": "show vendor", "id": "vendor", "default": false }],
  "presets": [
    {
      "name": "main-product",
      "settings": {}
    }
  ]
}
{% endschema %}
