<div class="footer page-pa gap-1">
  {% assign total_columns = 0 %}
  <div class="logo-description d-flex column align-left justify-left gap-2">
    {%- assign logo_width = settings.footer_logo_width | times: 8 -%}
    <img
      src="{{ settings.footer_logo | image_url }}"
      alt="{{ settings.footer_logo.alt | default: shop.name }}"
      width="{{ logo_width }}"
      height="auto"
      loading="lazy"
    >
    <span class="logo_description">
      {{ settings.description }}
    </span>
    {%- if settings.social_media_icons_flag -%}
      <div class="footer__social d-flex-imp">
        {% comment %} {% render 'social-media' %} {% endcomment %}
        {% render 'social-media', footer_only: true %}
      </div>
    {%- endif -%}
  </div>
  {%- for block in section.blocks -%}
    {% if block.type == 'link_list' %}
      <div class="footer-menu justify-self-center {% unless block.settings.mobile_menu_flag %}hide-mobile{% endunless %}">
        {% if block.settings.heading != blank %}
          <h4>{{ block.settings.heading }}</h4>
        {% endif %}

        {% assign footer_menu = linklists[block.settings.menu] %}
        {% if footer_menu.links.size > 0 %}
          <ul>
            {% for link in footer_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>

                {% if link.links != blank %}
                  <ul>
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}">
                          {{ child_link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
  {%- endfor -%}
  {%- if section.settings.policies_flag -%}
    <ul class="privacies-section d-flex row gap-2">
      {%- for policy in shop.policies -%}
        <li>
          {{ policy.title }}
        </li>
      {% endfor %}
    </ul>
  {%- endif -%}
</div>
<div class="company-info p-1">{{ 'general.info' | t }}</div>
{{ 'footer.css' | asset_url | stylesheet_tag }}
<style>
  .footer {
    background:{{ section.settings.bg_color }};
    {% assign total_columns = section.blocks.size | plus: 1 %}
    grid-template-columns: repeat({{ total_columns }}, 1fr);
  }
  .footer .logo-description img {
  mix-blend-mode: {{settings.footer_logo_blend}};
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "checkbox",
      "id": "policies_flag",
      "label": "Allow Policies",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Menu",
          "label": "Menu Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "footer"
        },
        {
          "type": "checkbox",
          "id": "mobile_menu_flag",
          "default": false,
          "label": "Mobile View",
          "info": "If checkbox is enabled then the menu will be visible in mobile view"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
